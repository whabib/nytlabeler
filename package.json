{
  "name": "nytlabeler",
  "version": "1.0.0",
  "description": "Automated Bluesky labeler for NY Times articles with monitoring dashboard",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "publish-definitions": "tsx src/publish-definitions.ts",
    "setup-labeler": "npx labeler setup",
    "test": "tsx --test tests/database.test.ts tests/jetstream.test.ts tests/labeler.test.ts tests/migrate-labels.test.ts tests/server.test.ts"
  },
  "dependencies": {
    "@atcute/cbor": "^1.0.7",
    "@atproto/api": "^0.13.11",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "labeler": "git+https://github.com/whabib/labeler.git#0254914f9f18b015ae740db1350fc58e93c6d141",
    "pg": "^8.12.0",
    "ws": "^8.17.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "@types/ws": "^8.5.10",
    "tsx": "^4.15.7",
    "typescript": "^5.5.2"
  }
}
