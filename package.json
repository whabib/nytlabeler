{
  "name": "nytlabeler",
  "version": "1.0.5",
  "description": "Automated Bluesky labeler for NY Times articles with monitoring dashboard",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "publish-definitions": "tsx src/publish-definitions.ts",
    "setup-labeler": "npx labeler setup",
    "test": "tsx --test tests/dashboard.test.ts tests/database.test.ts tests/firehose-leader.test.ts tests/firehose.test.ts tests/jetstream.test.ts tests/label-activity.test.ts tests/labeler.test.ts tests/server.test.ts"
  },
  "dependencies": {
    "@atproto/api": "^0.13.11",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "labeler": "git+https://github.com/whabib/labeler.git#da1e0a245f0615e54ae36ddb936fdd4a408e94cc",
    "pg": "^8.12.0",
    "ws": "^8.17.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "@types/ws": "^8.5.10",
    "jsdom": "^30.1.1",
    "tsx": "^4.15.7",
    "typescript": "^5.5.2"
  }
}
